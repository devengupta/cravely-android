<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/green" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/back" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:layout_marginStart="-8dp" android:src="@drawable/ic_back" android:tint="@color/white" android:background="?android:selectableItemBackgroundBorderless"/>
            <TextView style="@style/TopTitle" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Your Next Favourite"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5 dishes you’ve probably never ordered,\nbut are highly likely to love." android:textColor="#D3EBE1" android:textSize="13sp" android:lineSpacingMultiplier="1.2"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:scrollbars="none" android:clipToPadding="false">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView style="@style/Pill" android:background="@drawable/bg_pill_white" android:textColor="@color/green" android:text="All"/>
                <TextView style="@style/Pill" android:background="@drawable/bg_pill_dark" android:textColor="@color/white" android:text="Paneer Picks"/>
                <TextView style="@style/Pill" android:background="@drawable/bg_pill_dark" android:textColor="@color/white" android:text="Korean"/>
                <TextView style="@style/Pill" android:background="@drawable/bg_pill_dark" android:textColor="@color/white" android:text="Asian"/>
                <TextView style="@style/Pill" android:background="@drawable/bg_pill_dark" android:textColor="@color/white" android:text="Italian"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="16dp"/>
    </ScrollView>
</LinearLayout>
