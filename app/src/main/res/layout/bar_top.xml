<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/back" android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_back" android:tint="@color/ink" android:background="?android:selectableItemBackgroundBorderless" android:layout_marginStart="-8dp"/>
    <TextView android:id="@+id/title" style="@style/TopTitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Title"/>
    <ImageView android:id="@+id/action_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_share" android:tint="@color/ink" android:visibility="gone"/>
