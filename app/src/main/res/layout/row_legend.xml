<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <View android:id="@+id/dot" android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/dot_green"/>
    <TextView android:id="@+id/label" style="@style/Small" android:textSize="12sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp"/>
    <TextView android:id="@+id/pct" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
</LinearLayout>
