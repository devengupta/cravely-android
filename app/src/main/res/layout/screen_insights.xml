<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
<LinearLayout style="@style/Screen" android:paddingBottom="20dp">
    <include layout="@layout/bar_top"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView style="@style/Body" android:textColor="@color/ink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="You spent"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹6,842" android:textSize="34sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
            <TextView style="@style/Body" android:textColor="@color/ink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="on food this month."/>
            <TextView style="@style/Tag" android:layout_height="26dp" android:layout_marginTop="10dp" android:background="@drawable/bg_tag_mint" android:textColor="@color/green" android:textSize="11sp" android:text="↑ 12% from last month"/>
        </LinearLayout>
        <TextView style="@style/Pill" android:layout_gravity="end|top" android:layout_marginEnd="0dp" android:background="@drawable/bg_pill_white" android:textColor="@color/ink" android:text="This Month" android:drawableEnd="@drawable/ic_chevron_down" android:drawableTint="@color/ink" android:drawablePadding="2dp"/>
        <ImageView android:layout_width="110dp" android:layout_height="90dp" android:layout_gravity="end|bottom" android:layout_marginEnd="-6dp" android:src="@drawable/ill_insights" android:scaleType="fitCenter"/>
    </FrameLayout>
    <com.cravely.app.BarChartView android:id="@+id/bars" android:layout_width="match_parent" android:layout_height="170dp" android:layout_marginTop="12dp"/>
    <TextView style="@style/H2" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Quick Stats"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginEnd="5dp"><TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="11"/><TextView style="@style/Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Orders"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginStart="5dp" android:layout_marginEnd="5dp"><TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹641"/><TextView style="@style/Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Average order"/></LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginStart="5dp"><TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="₹1,384"/><TextView style="@style/Small" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Largest order"/></LinearLayout>
    </LinearLayout>
    <TextView style="@style/H2" android:textSize="15sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Where does your money go?"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="10dp">
        <com.cravely.app.DonutView android:id="@+id/donut" android:layout_width="118dp" android:layout_height="118dp"/>
        <LinearLayout android:id="@+id/legend" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="18dp"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>
