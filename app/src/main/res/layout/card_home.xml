<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="128dp" android:background="@drawable/bg_card_peach" android:foreground="?android:selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/c_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Order\nfor Me" android:textSize="15sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:lineSpacingMultiplier="0.95"/>
        <TextView android:id="@+id/c_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginEnd="56dp" android:text="Let AI pick tonight’s dinner" android:textSize="10.5sp" android:textColor="@color/muted"/>
    </LinearLayout>
    <ImageView android:id="@+id/c_img" android:layout_width="82dp" android:layout_height="78dp" android:layout_gravity="bottom|end" android:layout_marginEnd="2dp" android:layout_marginBottom="4dp" android:scaleType="fitEnd" android:src="@drawable/ill_order"/>
    <FrameLayout android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="bottom|start" android:layout_marginStart="14dp" android:layout_marginBottom="12dp" android:background="@drawable/bg_circle_white">
        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_gravity="center" android:src="@drawable/ic_arrow" android:tint="@color/ink"/>
    </FrameLayout>
</FrameLayout>
