<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream">
    <LinearLayout android:id="@+id/app_root" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:fitsSystemWindows="true">
        <FrameLayout android:id="@+id/container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <include layout="@layout/view_nav"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/splash_holder" android:layout_width="match_parent" android:layout_height="match_parent"/>
</FrameLayout>
