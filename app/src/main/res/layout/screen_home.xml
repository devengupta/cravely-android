<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none" android:fillViewport="true">
<LinearLayout style="@style/Screen" android:paddingTop="12dp" android:paddingBottom="16dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="104dp">
            <TextView style="@style/Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Good evening,"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Deven 👋" android:textSize="27sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:textStyle="bold"/>
            <TextView style="@style/Body" android:textColor="@color/ink" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="I know your food habits.\nWhat can I do for you today?"/>
        </LinearLayout>
        <ImageView android:layout_width="100dp" android:layout_height="96dp" android:layout_gravity="end|top" android:layout_marginTop="-4dp" android:src="@drawable/ill_mascot" android:scaleType="fitCenter"/>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_search" android:paddingStart="16dp" android:paddingEnd="14dp" android:elevation="1dp">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_search" android:tint="@color/muted"/>
        <TextView style="@style/Body" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Ask me anything about food..."/>
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_mic" android:tint="@color/ink"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:baselineAligned="false">
        <include android:id="@+id/card_order" layout="@layout/card_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="128dp" android:layout_marginEnd="6dp"/>
        <include android:id="@+id/card_fav" layout="@layout/card_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="128dp" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:baselineAligned="false">
        <include android:id="@+id/card_try" layout="@layout/card_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="128dp" android:layout_marginEnd="6dp"/>
        <include android:id="@+id/card_deals" layout="@layout/card_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="128dp" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp" android:baselineAligned="false">
        <include android:id="@+id/card_insights" layout="@layout/card_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="128dp" android:layout_marginEnd="6dp"/>
        <include android:id="@+id/card_profile" layout="@layout/card_home" android:layout_width="0dp" android:layout_weight="1" android:layout_height="128dp" android:layout_marginStart="6dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp" android:background="@drawable/bg_taste_banner" android:padding="16dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_sparkle" android:tint="@color/white"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your taste in one line" android:textColor="#BAE2CF" android:textSize="11sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="“Familiar flavours. New adventures.”" android:textColor="@color/white" android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
