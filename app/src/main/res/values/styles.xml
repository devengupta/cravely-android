<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Screen"><item name="android:layout_width">match_parent</item><item name="android:layout_height">match_parent</item><item name="android:orientation">vertical</item><item name="android:paddingStart">20dp</item><item name="android:paddingEnd">20dp</item><item name="android:clipToPadding">false</item></style>
    <style name="H1"><item name="android:textSize">26sp</item><item name="android:textColor">@color/ink</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textStyle">bold</item><item name="android:lineSpacingMultiplier">1.05</item></style>
    <style name="H2"><item name="android:textSize">17sp</item><item name="android:textColor">@color/ink</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:textStyle">bold</item></style>
    <style name="Body"><item name="android:textSize">13sp</item><item name="android:textColor">@color/muted</item><item name="android:lineSpacingMultiplier">1.25</item></style>
    <style name="Small"><item name="android:textSize">11sp</item><item name="android:textColor">@color/muted</item></style>
    <style name="Hand"><item name="android:fontFamily">casual</item><item name="android:textColor">#7A3B2E</item><item name="android:textSize">15sp</item></style>
    <style name="TopTitle"><item name="android:textSize">16sp</item><item name="android:textColor">@color/ink</item><item name="android:fontFamily">sans-serif-medium</item></style>
    <style name="Pill"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">32dp</item><item name="android:paddingStart">14dp</item><item name="android:paddingEnd">14dp</item><item name="android:gravity">center</item><item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:layout_marginEnd">8dp</item></style>
    <style name="Tag"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">22dp</item><item name="android:paddingStart">8dp</item><item name="android:paddingEnd">8dp</item><item name="android:gravity">center</item><item name="android:textSize">10sp</item><item name="android:fontFamily">sans-serif-medium</item><item name="android:drawablePadding">4dp</item></style>
    <style name="NavLabel"><item name="android:textSize">10sp</item><item name="android:textColor">@color/muted</item><item name="android:layout_marginTop">3dp</item></style>
</resources>
